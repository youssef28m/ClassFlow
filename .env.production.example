# Copy to .env.production (repo root) and fill in real values.
# Never commit .env.production.

# Database
POSTGRES_USER=classflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=classflow

# Host ports
BACKEND_PORT=8082
FRONTEND_PORT=8083

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-32+-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=classflow-api
JWT_AUDIENCE=classflow-client

# CORS - the origin of your frontend (must match where the browser loads it)
CORS_ORIGIN=http://localhost:8083

# Public URL the browser uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8082/api

# Rate limiting
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
SIGNUP_RATE_LIMIT=5

# Logging
LOG_LEVEL=info
