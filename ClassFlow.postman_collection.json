{
    "info": {
        "name": "ClassFlow API",
        "description": "Endpoints for the ClassFlow school management API.\n\nBefore testing: set the collection variable `baseUrl` (default http://localhost:3000), then run **Login** or **Signup** first — they auto-save the access token into `{{accessToken}}`.\n\nRole notes:\n- `/api/centers/**` requires SUPERADMIN.\n- `/api/students/**` and `/api/teachers/**` writes require SUPERADMIN/ADMIN/MANAGER/RECEPTIONIST.\n- For writes/by-id on students & teachers, non-SUPERADMINs use their token center automatically; SUPERADMINs must add `?centerId=<id>` (also set the `centerId` variable).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "accessToken",
            "value": ""
        },
        {
            "key": "centerId",
            "value": "1"
        },
        {
            "key": "studentId",
            "value": "1"
        },
        {
            "key": "teacherId",
            "value": "1"
        },
        {
            "key": "groupId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Health",
            "item": [
                {
                    "name": "GET /api/health",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "health"
                            ]
                        },
                        "description": "Public. Returns service status and uptime."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Auth",
            "item": [
                {
                    "name": "POST /api/auth/signup",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"receptionist1\",\n  \"password\": \"password123\",\n  \"centerId\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/signup",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "signup"
                            ]
                        },
                        "description": "Public (rate-limited). Creates a RECEPTIONIST user. `centerId` optional — defaults to the first active center. Returns 201 with accessToken + user, and sets the refreshToken HttpOnly cookie."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (pm.response.code === 201 && json.accessToken) {",
                                    "  pm.collectionVariables.set('accessToken', json.accessToken);",
                                    "}",
                                    "if (json.user && json.user.centerId) {",
                                    "  pm.collectionVariables.set('centerId', String(json.user.centerId));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /api/auth/login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"receptionist1\",\n  \"password\": \"password123\",\n  \"centerId\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Public (rate-limited). Returns 200 with accessToken + user, and sets the refreshToken HttpOnly cookie. `centerId` optional — used to disambiguate when the same username exists in multiple centers."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (pm.response.code === 200 && json.accessToken) {",
                                    "  pm.collectionVariables.set('accessToken', json.accessToken);",
                                    "}",
                                    "if (json.user && json.user.centerId) {",
                                    "  pm.collectionVariables.set('centerId', String(json.user.centerId));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /api/auth/refresh",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": ""
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "refresh"
                            ]
                        },
                        "description": "Public (rate-limited). Reads the `refreshToken` cookie sent by a previous login/signup. Rotates the token and returns 200 with a new accessToken + refreshed cookie."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (pm.response.code === 200 && json.accessToken) {",
                                    "  pm.collectionVariables.set('accessToken', json.accessToken);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /api/auth/logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": ""
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Requires Bearer token + refresh cookie. Revokes the current refresh token. Returns 204."
                    },
                    "response": []
                },
                {
                    "name": "POST /api/auth/logout-all",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": ""
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/logout-all",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout-all"
                            ]
                        },
                        "description": "Requires Bearer token. Revokes all refresh tokens for the user. Returns 204."
                    },
                    "response": []
                },
                {
                    "name": "GET /api/auth/me",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Requires Bearer token. Returns the current user."
                    },
                    "response": []
                }
            ]
        },
