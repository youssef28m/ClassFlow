# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Security
CORS_ORIGIN=http://localhost:5173

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-32+-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=classflow-api
JWT_AUDIENCE=classflow-client

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classflow?schema=public
